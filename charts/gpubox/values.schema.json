{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "namespace": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string" }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": { "type": "array" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "pod": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "hostPID": { "type": "boolean" },
        "hostNetwork": { "type": "boolean" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "priorityClassName": { "type": "string" },
        "runtimeClassName": { "type": "string" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "env": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "TUNNEL_NAME": { "type": "string" },
        "WORKDIR": { "type": "string" }
      }
    },
    "extraEnv": { "type": "array" },
    "envFrom": { "type": "array" },
    "container": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "stdin": { "type": "boolean" },
        "tty": { "type": "boolean" }
      }
    },
    "containerPorts": { "type": "array" },
    "ssh": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "authorizedKeys": { "type": "array", "items": { "type": "string" } },
        "existingAuthorizedKeysConfigMap": { "type": "string" },
        "owner": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "uid": { "type": "integer", "minimum": 0 },
            "gid": { "type": "integer", "minimum": 0 }
          }
        },
        "initContainer": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "image": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "repository": { "type": "string" },
                "tag": { "type": "string" },
                "pullPolicy": { "type": "string" }
              }
            },
            "securityContext": { "type": "object" },
            "resources": { "type": "object" }
          }
        }
      }
    },
    "command": { "type": "array" },
    "args": { "type": "array" },
    "resources": { "type": "object" },
    "sharedMemory": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "sizeLimit": { "type": "string", "minLength": 1 }
      }
    },
    "tailscale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          },
          "required": ["repository", "tag", "digest", "pullPolicy"]
        },
        "authKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": { "type": "string" },
            "existingSecret": { "type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$" },
            "secretKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
          },
          "required": ["value", "existingSecret", "secretKey"]
        },
        "hostname": {
          "type": "string",
          "anyOf": [
            { "const": "" },
            {
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$"
            },
            {
              "maxLength": 254,
              "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.$"
            }
          ]
        },
        "acceptDNS": { "type": "boolean" },
        "acceptRoutes": { "type": "boolean" },
        "extraArgs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "^\\S+$" }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string", "minLength": 1 }
            },
            "required": ["name"]
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingClaim": { "type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$" },
            "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
            "labels": { "type": "object", "additionalProperties": { "type": "string" } },
            "storageClass": { "type": "string" },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] }
            },
            "volumeMode": { "type": "string", "const": "Filesystem" },
            "size": { "type": "string", "pattern": "^[0-9]+([EPTGMK]i?|[eE][+-]?[0-9]+|m)?$" },
            "mountPath": { "type": "string", "pattern": "^/\\S*$" }
          },
          "required": ["existingClaim", "annotations", "labels", "storageClass", "accessModes", "volumeMode", "size", "mountPath"]
        },
        "securityContext": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "privileged": { "const": true },
            "allowPrivilegeEscalation": { "type": "boolean" },
            "runAsUser": { "type": "integer", "minimum": 0 }
          },
          "required": ["privileged"]
        },
        "resources": { "type": "object" },
        "startupProbe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "timeoutSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          },
          "required": ["initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"]
        },
        "sysctl": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "securityContext": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "privileged": { "const": true },
                "allowPrivilegeEscalation": { "type": "boolean" },
                "runAsUser": { "type": "integer", "minimum": 0 }
              },
              "required": ["privileged"]
            },
            "resources": { "type": "object" }
          },
          "required": ["securityContext", "resources"]
        }
      },
      "required": ["enabled", "image", "authKey", "hostname", "acceptDNS", "acceptRoutes", "extraArgs", "extraEnv", "state", "securityContext", "resources", "startupProbe", "sysctl"]
    },
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "headless": { "type": "boolean" },
        "publishNotReadyAddresses": { "type": "boolean" },
        "type": { "type": "string" },
        "clusterIP": { "type": "string" },
        "ports": { "type": "array" }
      }
    },
    "statefulSet": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "updateStrategy": { "type": "object" },
        "podManagementPolicy": { "type": "string" },
        "revisionHistoryLimit": { "type": "integer", "minimum": 0 }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "persistence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "home": { "type": "object" },
        "transfer": { "type": "object" },
        "tmp": { "type": "object" },
        "hostRoot": { "type": "object" }
      }
    },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "initContainers": { "type": "array" },
    "sidecars": { "type": "array" },
    "extraResources": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": true
          },
          {
            "type": "string",
            "minLength": 1
          }
        ]
      }
    }
  },
  "required": ["tailscale"]
}
